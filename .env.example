APP_NAME="Peminjaman Mobil"
# local saat pengembangan; production saat dipakai (APP_DEBUG=false).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Pengembangan: http://localhost:8000 (composer run dev).
# PC kantor: https://sistem-peminjaman-mobil.test (SSL Laragon). Server: domain HTTPS.
APP_URL=http://localhost:8000

# Aturan Terlambat, Belum Diambil, dan toleransi waktu mulai bergantung pada
# jam server; jangan diubah antar lingkungan.
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development lokal sementara memakai root Laragon. Sebelum dipakai, ganti
# dengan user MySQL khusus aplikasi (lihat README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peminjaman_mobil
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Otomatis true saat APP_ENV=production. Set true manual bila HTTPS aktif di staging/test.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Aplikasi tidak mengirim email; driver log cukup.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sistem Peminjaman Mobil ---

# Akun Pengelola pertama yang dibuat oleh `php artisan db:seed`.
# Password ini sementara dan wajib diganti saat login pertama.
FLEET_MANAGER_NAME="Pengelola"
FLEET_MANAGER_EMAIL=
FLEET_MANAGER_PASSWORD=

# true = Pengelola wajib mengaktifkan autentikasi dua faktor sebelum dapat
# memakai aplikasi. Disarankan true bila sistem dapat diakses dari internet.
FLEET_REQUIRE_2FA_FOR_MANAGER=false

# true = tolak password yang pernah bocor (dicek ke layanan Have I Been Pwned,
# butuh internet). Disarankan true bila sistem dapat diakses dari internet.
FLEET_PASSWORD_CHECK_UNCOMPROMISED=false

# Pemisah kolom file CSV hasil ekspor Riwayat. Excel memakai pemisah daftar
# dari pengaturan Region Windows: "," untuk English (United States), ";" untuk
# Indonesia. Bila CSV terbuka dalam satu kolom di Excel, ganti menjadi ";".
FLEET_CSV_DELIMITER=","

# Durasi peminjaman (waktu mulai sampai rencana kembali, termasuk setelah
# perpanjangan). Kosongkan FLEET_MAX_BOOKING_DAYS = tanpa batas maksimal; isi
# angka hari (mis. 30) bila kantor menetapkan batas, maka penyimpanan ditolak.
# Di atas FLEET_LONG_BOOKING_WARNING_DAYS hari, form hanya meminta konfirmasi.
FLEET_MAX_BOOKING_DAYS=
FLEET_LONG_BOOKING_WARNING_DAYS=7

# --- Backup & Pemeliharaan (PRD 13.1 & Prompt 8) ---
# Lokasi binary mysqldump. Di Laragon Windows biasanya di:
# C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin (sesuaikan versi MySQL)
DB_DUMP_PATH="C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin"

# Disk penyimpanan file backup (default: disk backup lokal di storage/app/backups).
# Di PC kantor / server, disarankan mengarahkan BACKUP_DISK_PATH ke drive/partisi terpisah (mis. D:/backups).
BACKUP_DISK=backup
BACKUP_DISK_PATH=

# Inertia DevTools merekam setiap request (termasuk data pribadi) dan bisa
# dibaca tanpa login. Biarkan false; nyalakan sementara hanya untuk debugging
# di laptop pengembang.
INERTIA_DEVTOOLS_ENABLED=false

